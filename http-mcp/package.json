{
  "name": "@dacs-agent-commerce/dacs-chatgpt-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private DACS testnet ChatGPT plugin: Streamable HTTP MCP server, OAuth 2.1 account linking, wallet signing portal.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "dacs-chatgpt-plugin": "./bin/dacs-chatgpt-plugin.mjs",
    "dacs-ops-health": "./bin/dacs-ops-health.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "skills/",
    "plugin.json",
    "mcp.json",
    ".env.example",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning ./bin/dacs-chatgpt-plugin.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 ./test/*.test.mjs",
    "test:ci": "node scripts/run-test-files.mjs . test-results.jsonl 600 --browser --known test/known-failures.json",
    "test:browser": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 ./test/browser/*.test.mjs",
    "check:package": "node ./scripts/check-package.mjs"
  },
  "dependencies": {
    "@kynesyslabs/dacs": "file:vendor/kynesyslabs-dacs-0.1.0-alpha.0.tgz",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "express": "5.2.1",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  },
  "bundleDependencies": [
    "@kynesyslabs/dacs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DACS-Agent-commerce/dacs-plugin.git",
    "directory": "http-mcp"
  }
}
