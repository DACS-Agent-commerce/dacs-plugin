# DACS ChatGPT plugin configuration. PLACEHOLDERS ONLY: copy to your host's
# secret manager (or a local .env that is never committed) and replace values.

# Stable public HTTPS origin that serves /mcp (no path). Required.
DACS_PUBLIC_ORIGIN=https://dacs-plugin.example.invalid
HOST=0.0.0.0
PORT=8787
# Set to 1 only behind a TLS-terminating reverse proxy you control.
DACS_TRUST_PROXY=0
# Local development only: allow http://127.0.0.1 / http://localhost origins.
DACS_ALLOW_INSECURE_LOCALHOST=0

# Persistent storage (mount a volume here in containers).
DACS_DATA_DIR=/data

# Purchase admission: positive limits; accepted starts include cancellations.
DACS_MAX_UNPAID_PURCHASES_PER_ACCOUNT=1
DACS_MAX_UNPAID_PURCHASES_PER_WALLET=1
DACS_MAX_PURCHASE_STARTS_PER_ACCOUNT_PER_HOUR=5

# Authorization: builtin (wallet-login OAuth 2.1 server at /oauth) or external.
DACS_AUTH_MODE=builtin
# builtin: comma-separated random secrets, >= 32 chars each, for OAuth cookies.
# The placeholder below is deliberately invalid: the server refuses to start with it.
DACS_OAUTH_COOKIE_KEYS=REPLACE_ME
DACS_ACCESS_TOKEN_TTL_SECONDS=900
DACS_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com
DACS_CIMD_ALLOWED_HOSTS=chatgpt.com
# external: your identity provider's exact issuer identifier.
# DACS_OAUTH_ISSUER=https://your-tenant.example-idp.invalid/
# DACS_OAUTH_JWKS_URI=
# DACS_OAUTH_SCOPE_CLAIM=scope
# DACS_OAUTH_REQUIRE_AT_JWT=1

# Community DACS directory (HTTPS origin). Unset = discovery reported as not configured.
DACS_DIRECTORY_ORIGIN=https://dacs-directory.example.invalid
# Demos testnet RPC used for read-only chain verification. Unset = not configured.
DACS_CHAIN_RPC_URL=https://demos-testnet-rpc.example.invalid
# Network label: [a-z0-9._-], starting with a letter or digit, at most 64 (checked at startup).
DACS_CHAIN_NETWORK=demos-testnet
# os-string (post OS-denomination fork) or dem-number (pre-fork). Confirm for your network.
DACS_DEM_AMOUNT_ENCODING=os-string

# Identity add/remove (offline candidate). Keep "held": real-wallet compatibility,
# the proof format and the wallet network are not yet established.
DACS_IDENTITY_WRITES=held

# Built-in wallet payments/identity changes: off by default. The packaged
# offline tester explicitly enables simulated-loopback with local fixtures.
# This does not enable live/testnet writes. Keep off on deployed servers.
DACS_EMBEDDED_WALLET_WRITES=off
# Fixture GitHub lookup only; the offline tester configures this automatically.
# DACS_EMBEDDED_WALLET_GITHUB_API_ORIGIN=http://127.0.0.1:<fixture-port>

DACS_RATE_LIMIT_PER_MINUTE=600
DACS_LOG_LEVEL=info
