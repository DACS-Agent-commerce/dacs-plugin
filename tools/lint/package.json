{
  "name": "dacs-plugin-lint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Linter for the plugin repo. Kept apart from the plugins so it never ships in their packages.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "lint": "cd ../.. && eslint --config tools/lint/eslint.config.mjs --suppressions-location tools/lint/eslint-suppressions.json --no-warn-ignored .",
    "lint:prune": "cd ../.. && eslint --config tools/lint/eslint.config.mjs --suppressions-location tools/lint/eslint-suppressions.json --no-warn-ignored --prune-suppressions ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
